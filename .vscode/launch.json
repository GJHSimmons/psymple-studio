{
  // Debug the backend with breakpoints (F5). Requires the Python extension.
  // --reload is intentionally omitted here: uvicorn's reloader spawns a subprocess
  // the debugger won't attach to. Use the "app" task (tasks.json) for normal dev.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend (uvicorn, debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--app-dir", "backend", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "justMyCode": false
    }
  ]
}
